# 100% offline base - expects offline/ folder from prepare_all_offline.sh in build context
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0
ENV DEBIAN_FRONTEND=noninteractive CUDA_HOME=/usr/local/cuda PATH=/usr/local/cuda/bin:$PATH LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib:$LD_LIBRARY_PATH TORCH_CUDA_ARCH_LIST=8.7 CUDAARCHS=87 OPENBLAS_CORETYPE=ARMV8 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MAX_JOBS=4
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git wget pkg-config python3-dev python3-pip libopenblas-dev libopenmpi-dev libomp-dev libjpeg-dev libpng-dev libavcodec-dev libavformat-dev libswscale-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libtbb-dev libatlas-base-dev espeak-ng alsa-utils libopenblas0 libopenmpi3 libomp5 libjpeg-turbo8 libpng16-16 libavcodec58 libavformat58 libswscale5 libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libtbb2 libatlas3-base && rm -rf /var/lib/apt/lists/*

COPY offline/wheels /tmp/wheels
RUN pip3 install --no-cache-dir --upgrade --no-index --find-links=/tmp/wheels pip wheel && pip3 install --no-index --find-links=/tmp/wheels --no-cache-dir cmake==3.27.7 scikit-build numpy==1.26.4 certifi charset-normalizer filelock==3.29.0 fsspec future idna==3.17 Jinja2==3.1.6 MarkupSafe==3.0.3 mpmath==1.3.0 networkx==3.4.2 packaging==26.2 pillow==12.2.0 PyYAML==6.0.3 requests==2.34.2 six==1.17.0 sympy==1.14.0 typing_extensions==4.15.0 urllib3==2.7.0

COPY offline/pytorch-v2.4.0-with-deps.tar.gz /tmp/
RUN cd /tmp && tar xzf pytorch-v2.4.0-with-deps.tar.gz && cd /tmp/pytorch && TORCH_CUDA_ARCH_LIST="8.7" CUDAARCHS="87" USE_NCCL=0 USE_DISTRIBUTED=0 USE_QNNPACK=0 USE_PYTORCH_QNNPACK=0 BUILD_TEST=0 USE_FBGEMM=0 USE_KINETO=0 USE_CUPTI=0 BUILD_CAFFE2=0 python3 setup.py bdist_wheel && pip3 install --no-cache-dir /tmp/pytorch/dist/*.whl && rm -rf /tmp/pytorch /tmp/pytorch-v2.4.0-with-deps.tar.gz

RUN apt-get update && apt-get install -y --no-install-recommends ninja-build && rm -rf /var/lib/apt/lists/*

COPY offline/vision-48b1edf.tar.gz /tmp/
RUN mkdir -p /tmp/vision && tar xzf /tmp/vision-48b1edf.tar.gz -C /tmp/vision --strip-components=1 && cd /tmp/vision && python3 setup.py bdist_wheel && pip3 install --no-cache-dir /tmp/vision/dist/*.whl && rm -rf /tmp/vision /tmp/vision-48b1edf.tar.gz

COPY offline/audio-v2.4.0.tar.gz /tmp/
RUN mkdir -p /tmp/audio && tar xzf /tmp/audio-v2.4.0.tar.gz -C /tmp/audio --strip-components=1 && cd /tmp/audio && BUILD_SOX=0 BUILD_RIR=0 BUILD_RNNT=0 BUILD_ALIGN=0 BUILD_CUDA_CTC_DECODER=0 USE_FFMPEG=1 python3 setup.py bdist_wheel && pip3 install --no-cache-dir /tmp/audio/dist/*.whl && rm -rf /tmp/audio /tmp/audio-v2.4.0.tar.gz

RUN apt-get update && apt-get install -y --no-install-recommends libgtk2.0-dev libgtk-3-dev pkg-config && rm -rf /var/lib/apt/lists/*

COPY offline/opencv-4.10.0.tar.gz offline/opencv_contrib-4.10.0.tar.gz /tmp/
RUN cd /tmp && tar xzf opencv-4.10.0.tar.gz && tar xzf opencv_contrib-4.10.0.tar.gz && cd /tmp && mv opencv-4.10.0 opencv 2>/dev/null || mv opencv-* opencv || true && mv opencv_contrib-4.10.0 opencv_contrib 2>/dev/null || mv opencv_contrib-* opencv_contrib || true && cd /tmp/opencv && mkdir build && cd build && cmake -D CMAKE_BUILD_TYPE=RELEASE -D CMAKE_INSTALL_PREFIX=/usr/local -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules -D WITH_CUDA=ON -D CUDA_ARCH_BIN=8.7 -D CUDA_ARCH_PTX="" -D WITH_CUDNN=ON -D OPENCV_DNN_CUDA=ON -D WITH_GSTREAMER=ON -D WITH_LIBV4L=ON -D WITH_GTK=ON -D WITH_GTK_2_X=ON -D BUILD_opencv_python3=ON -D BUILD_TESTS=OFF -D BUILD_PERF_TESTS=OFF -D BUILD_EXAMPLES=OFF .. && make -j2 && make install && ldconfig && rm -rf /tmp/opencv* /tmp/opencv_contrib*

RUN pip3 install --no-index --find-links=/tmp/wheels --no-cache-dir onnx onnx-graphsurgeon
RUN pip3 install --no-index --find-links=/tmp/wheels --force-reinstall --no-cache-dir numpy==1.26.4
RUN python3 -c "import torch, cv2; print('BASE OFFLINE OK', torch.__version__, cv2.__version__)"
