# Base - offline, no git clone in docker, just unpack your pre-downloaded tarball
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0
ENV DEBIAN_FRONTEND=noninteractive CUDA_HOME=/usr/local/cuda PATH=/usr/local/cuda/bin:$PATH LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/targets/aarch64-linux/lib:$LD_LIBRARY_PATH TORCH_CUDA_ARCH_LIST=8.7 CUDAARCHS=87 OPENBLAS_CORETYPE=ARMV8 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MAX_JOBS=4

RUN apt-get update && apt-get install -y --no-install-recommends build-essential git wget pkg-config python3-dev python3-pip libopenblas-dev libopenmpi-dev libomp-dev libjpeg-dev libpng-dev libavcodec-dev libavformat-dev libswscale-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libtbb-dev libatlas-base-dev espeak-ng alsa-utils libopenblas0 libopenmpi3 libomp5 libjpeg-turbo8 libpng16-16 libavcodec58 libavformat58 libswscale5 libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libtbb2 libatlas3-base && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip wheel && pip3 install --no-cache-dir cmake==3.27.7

RUN pip3 install --no-cache-dir numpy==1.26.4 certifi charset-normalizer filelock==3.29.0 fsspec future idna==3.17 Jinja2==3.1.6 MarkupSafe==3.0.3 mpmath==1.3.0 networkx==3.4.2 packaging==26.2 pillow==12.2.0 PyYAML==6.0.3 requests==2.34.2 six==1.17.0 sympy==1.14.0 typing_extensions==4.15.0 urllib3==2.7.0 scikit-build

# COPY instead of git clone - you create this tarball on host with prepare_pytorch_offline.sh
COPY pytorch-v2.4.0-with-deps.tar.gz /tmp/
RUN cd /tmp && tar xzf pytorch-v2.4.0-with-deps.tar.gz && cd /tmp/pytorch && TORCH_CUDA_ARCH_LIST="8.7" CUDAARCHS="87" USE_NCCL=0 USE_DISTRIBUTED=0 USE_QNNPACK=0 USE_PYTORCH_QNNPACK=0 BUILD_TEST=0 USE_FBGEMM=0 USE_KINETO=0 USE_CUPTI=0 BUILD_CAFFE2=0 python3 setup.py bdist_wheel
RUN pip3 install --no-cache-dir /tmp/pytorch/dist/*.whl && rm -rf /tmp/pytorch /tmp/pytorch-v2.4.0-with-deps.tar.gz && python3 -c "import torch; print(torch.__version__)"

# vision / audio still need small clones but with retries - these are 5min not 5h
RUN apt-get update && apt-get install -y --no-install-recommends ninja-build && rm -rf /var/lib/apt/lists/*
RUN for i in 1 2 3 4 5; do rm -rf /tmp/vision; git clone https://github.com/pytorch/vision.git /tmp/vision && break || sleep 15; done && cd /tmp/vision && git checkout 48b1edf && python3 setup.py bdist_wheel
RUN pip3 install --no-cache-dir /tmp/vision/dist/*.whl && rm -rf /tmp/vision
RUN for i in 1 2 3 4 5; do rm -rf /tmp/audio; git clone --branch v2.4.0 --depth 1 https://github.com/pytorch/audio.git /tmp/audio && break || sleep 15; done && cd /tmp/audio && BUILD_SOX=0 BUILD_RIR=0 BUILD_RNNT=0 BUILD_ALIGN=0 BUILD_CUDA_CTC_DECODER=0 USE_FFMPEG=1 python3 setup.py bdist_wheel
RUN pip3 install --no-cache-dir /tmp/audio/dist/*.whl && rm -rf /tmp/audio

RUN wget -q -O /tmp/opencv.tar.gz https://github.com/opencv/opencv/archive/4.10.0.tar.gz && wget -q -O /tmp/opencv_contrib.tar.gz https://github.com/opencv/opencv_contrib/archive/4.10.0.tar.gz && cd /tmp && tar -xzf opencv.tar.gz && tar -xzf opencv_contrib.tar.gz
RUN cd /tmp/opencv-4.10.0 && mkdir build && cd build && cmake -D CMAKE_BUILD_TYPE=RELEASE -D CMAKE_INSTALL_PREFIX=/usr/local -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib-4.10.0/modules -D WITH_CUDA=ON -D CUDA_ARCH_BIN=8.7 -D CUDA_ARCH_PTX="" -D WITH_CUDNN=ON -D OPENCV_DNN_CUDA=ON -D WITH_GSTREAMER=ON -D WITH_LIBV4L=ON -D BUILD_opencv_python3=ON -D BUILD_TESTS=OFF -D BUILD_PERF_TESTS=OFF -D BUILD_EXAMPLES=OFF .. && make -j2
RUN cd /tmp/opencv-4.10.0/build && make install && ldconfig && rm -rf /tmp/opencv.tar.gz /tmp/opencv_contrib.tar.gz /tmp/opencv-4.10.0 /tmp/opencv_contrib-4.10.0
RUN pip3 install --no-cache-dir onnx onnx-graphsurgeon
